# Server Configuration
PROJECT_NAME="LegalMind AI Service"
API_V1_STR="/api/v1"
HOST="0.0.0.0"
PORT=8000
DEBUG=True
LOG_LEVEL="INFO"

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5000","http://localhost:5173"]

# ML Models & Vector Store Settings
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
SPACY_MODEL="en_core_web_sm"
FAISS_INDEX_PATH="./data/faiss_index"
DEVICE="cpu"

# Gemini API Configuration (Get key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Reranker Configuration
RERANKER_MODEL="cross-encoder/ms-marco-MiniLM-L-6-v2"
