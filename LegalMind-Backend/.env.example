# LegalMind Backend — Environment Variables
# Copy this file to .env for local development.
# On Koyeb: add each variable in the Service > Settings > Environment Variables panel.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=production

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get from: https://cloud.mongodb.com → Connect → Drivers → Node.js
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/legalmind?retryWrites=true&w=majority&appName=LegalMindCluster

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins (your Vercel frontend URL)
CORS_ORIGIN=https://your-legalmind.vercel.app

# ── AI Service ───────────────────────────────────────────────────────────────
# Your Hugging Face Spaces URL (set after Phase 4)
AI_SERVICE_URL=https://YOUR_HF_USERNAME-legalmind-ai.hf.space
